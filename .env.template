# Path to yt-dlp binary (defaults to 'yt-dlp' if not set)
YTDLP_PATH=yt-dlp

# yt-dlp self-updates on boot and every 12h. YouTube breaks older yt-dlp
# releases every few weeks, which shows up as most downloads failing with 403s.
# Set to false only if you manage the binary yourself.
YTDLP_AUTO_UPDATE=true

# Resend API key for the contact form (https://resend.com/api-keys)
RESEND_API_KEY=

# Email address that contact form messages are delivered to
CONTACT_TO_EMAIL=
